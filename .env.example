# Optional overrides. The YAML config is the primary configuration source.
LINKEDIN_HEADLESS=0
LINKEDIN_INCOGNITO=0
LINKEDIN_USE_UC=0
LINKEDIN_PROFILE_DIR=.browser-profile
LINKEDIN_LOCALE=en-US
LINKEDIN_PAGE_TIMEOUT=45
LINKEDIN_WAIT_TIMEOUT=20
LINKEDIN_SCROLL_PAUSE_MIN=1.0
LINKEDIN_SCROLL_PAUSE_MAX=2.0
LINKEDIN_STAGNATION_LIMIT=3
LINKEDIN_MAX_SCROLL_ROUNDS=250
LINKEDIN_SEARCH_DEADLINE_SECONDS=900
LINKEDIN_DEBUG_PAUSE_AFTER_FIRST_REQUEST_SECONDS=0
JOB_HARVESTER_DB=data/jobs.sqlite3
LOG_LEVEL=INFO
